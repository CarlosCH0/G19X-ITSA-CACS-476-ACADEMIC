# Copia este archivo como .env y ajusta los valores (nunca subas el .env al repositorio).

# --- Base de datos ---
# Desarrollo local con SQLite:
DATABASE_URL=sqlite:///./talento.db
# Implementación con PostgreSQL (docker-compose):
# DATABASE_URL=postgresql+psycopg2://talento:talento@localhost:5432/talento

# --- Seguridad (RNF-01, RNF-05) ---
SECRET_KEY=genera-una-clave-larga-y-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Arranque ---
ENTORNO=desarrollo
SEED_DEMO_DATA=true
ADMIN_EMAIL=admin@develop.com.mx
ADMIN_PASSWORD=Admin123!

# --- Modelo analítico ---
MODELO_VERSION=reglas-v1

# --- Azure OpenAI Service (RF-08, opcional) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview
IA_TIMEOUT_SEGUNDOS=20
