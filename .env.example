# Copia este archivo como .env, sustituye los ejemplos y no subas el .env al repositorio.
# Genera secretos con: python -c "import secrets; print(secrets.token_hex(32))"

# --- Base de datos ---
# Desarrollo local con SQLite:
DATABASE_URL=sqlite:///./talento.db
# Implementación con PostgreSQL (docker-compose):
POSTGRES_PASSWORD=reemplazar-con-secreto-aleatorio-de-al-menos-24-caracteres
# DATABASE_URL=postgresql+psycopg2://talento:talento@localhost:5432/talento

# --- Seguridad (RNF-01, RNF-05) ---
SECRET_KEY=reemplazar-con-secreto-aleatorio-de-al-menos-32-caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Arranque ---
ENTORNO=desarrollo
SEED_DEMO_DATA=true
ADMIN_EMAIL=admin@cliente.example
ADMIN_PASSWORD=reemplazar-con-contraseña-unica-de-al-menos-12-caracteres

# --- Modelo analítico ---
MODELO_VERSION=reglas-v1

# --- Azure OpenAI Service (RF-08, opcional) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview
IA_TIMEOUT_SEGUNDOS=20
