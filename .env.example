# Copia como .env, sustituye todos los ejemplos y no subas ese archivo al repositorio.
# Para producir secretos: python -c "import secrets; print(secrets.token_hex(32))"
# POSTGRES_PASSWORD debe tener al menos 24 caracteres; el formato hexadecimal evita
# caracteres reservados en la URL de conexión.
POSTGRES_PASSWORD=reemplazar-con-secreto-aleatorio-alfanumerico-de-64-caracteres
SECRET_KEY=reemplazar-con-secreto-aleatorio-de-al-menos-32-caracteres
ADMIN_EMAIL=admin@cliente.example
ADMIN_PASSWORD=reemplazar-con-contraseña-unica-de-al-menos-12-caracteres
WEB_BIND=127.0.0.1
WEB_PORT=8081

# Configuración para ejecutar el backend fuera de Docker en desarrollo local.
DATABASE_URL=sqlite:///./talento.db
ENTORNO=desarrollo
SEED_DEMO_DATA=true
ACCESS_TOKEN_EXPIRE_MINUTES=480
MODELO_VERSION=reglas-v1

# Azure OpenAI (opcional; sin credenciales se usa el modo local).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview
IA_TIMEOUT_SEGUNDOS=20
