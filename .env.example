# MVP — Copia este archivo como .env y ajusta los valores (nunca subas el .env).

# --- Base de datos ---
# Desarrollo local con SQLite:
DATABASE_URL=sqlite:///./talento_mvp.db
# Implementación con PostgreSQL (docker-compose):
# DATABASE_URL=postgresql+psycopg2://talento:talento@localhost:5433/talento

# --- Seguridad (RNF-01, RNF-05) ---
SECRET_KEY=genera-una-clave-larga-y-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Arranque ---
ENTORNO=desarrollo
SEED_DEMO_DATA=true
ADMIN_EMAIL=admin@develop.com.mx
ADMIN_PASSWORD=Admin123!

# --- Modelo analítico ---
MODELO_VERSION=reglas-v1
